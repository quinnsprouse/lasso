{
  "name": "@quinnsprouse/lasso",
  "version": "0.1.0",
  "description": "Agent-first CLI starter kit. Machine surface by default, guardrails that fail mechanically.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "lasso": "./bin/lasso.cjs"
  },
  "files": [
    "bin",
    "dist",
    "skills"
  ],
  "engines": {
    "node": ">=22.19",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "node src/bin.ts",
    "build": "tsdown",
    "check": "node scripts/verify.mjs fast",
    "check:push": "node scripts/verify.mjs push",
    "check:ci": "node scripts/verify.mjs ci",
    "test": "vitest run test/unit test/contract",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint --type-aware --deny-warnings",
    "fmt": "biome format --write .",
    "fmt:check": "biome format .",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "setup": "lefthook install",
    "test:e2e": "vitest run test/e2e",
    "prepack": "tsdown --logLevel silent",
    "prepare": "effect-tsgo patch --oxlint",
    "doctor": "node scripts/doctor.mjs",
    "release:prepare": "node scripts/release.mjs",
    "surface:update": "node scripts/surface-snapshot.mjs",
    "test:starter": "node scripts/starter-contract.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@effect/platform-node": "4.0.0-beta.106",
    "@effect/tsgo": "0.36.1",
    "@types/node": "26.4.1",
    "@vitest/coverage-v8": "5.0.0",
    "effect": "4.0.0-beta.106",
    "execa": "10.0.1",
    "fast-check": "4.9.0",
    "knip": "6.34.0",
    "lefthook": "2.1.12",
    "oxlint": "1.77.0",
    "oxlint-tsgolint": "7.0.2001",
    "publint": "0.3.24",
    "tsdown": "0.23.0",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quinnsprouse/lasso.git"
  },
  "keywords": [
    "cli",
    "effect",
    "typescript",
    "ai-agent",
    "agent-first",
    "starter-kit",
    "json",
    "ndjson"
  ],
  "homepage": "https://github.com/quinnsprouse/lasso#readme",
  "bugs": {
    "url": "https://github.com/quinnsprouse/lasso/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
