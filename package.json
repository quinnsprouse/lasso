{
  "name": "lasso",
  "version": "0.1.0",
  "private": false,
  "description": "Agent-first CLI starter kit. Machine surface by default, guardrails that fail mechanically.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "lasso": "./bin/lasso.cjs"
  },
  "files": [
    "bin",
    "dist"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node --experimental-strip-types src/bin.ts",
    "build": "tsdown",
    "check": "node scripts/verify.mjs fast",
    "check:push": "node scripts/verify.mjs push",
    "check:ci": "node scripts/verify.mjs ci",
    "test": "vitest run test/unit test/contract",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:contract": "node scripts/starter-contract.mjs",
    "lint": "oxlint --type-aware --deny-warnings",
    "fmt": "biome format --write .",
    "fmt:check": "biome format .",
    "typecheck": "tsc --noEmit",
    "effect:diagnostics": "effect-tsgo diagnostics --project tsconfig.json --strict",
    "knip": "knip",
    "setup": "lefthook install",
    "test:e2e": "vitest run test/e2e",
    "prepack": "tsdown --logLevel silent"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@effect/platform-node": "4.0.0-beta.106",
    "@effect/tsgo": "0.36.1",
    "@types/node": "24.3.0",
    "@vitest/coverage-v8": "4.1.10",
    "effect": "4.0.0-beta.106",
    "execa": "10.0.1",
    "fast-check": "4.9.0",
    "knip": "6.32.0",
    "lefthook": "2.1.10",
    "oxlint": "1.77.0",
    "oxlint-tsgolint": "7.0.2001",
    "publint": "0.3.23",
    "tsdown": "0.22.14",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quinnsprouse/lasso.git"
  }
}
