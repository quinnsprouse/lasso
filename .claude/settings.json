{
  "permissions": {
    "allow": [
      "Bash(npm ci)",
      "Bash(npm run check)",
      "Bash(npm run check:push)",
      "Bash(npm run check:ci)",
      "Bash(npm run lint)",
      "Bash(npm run typecheck)",
      "Bash(npm run test)",
      "Bash(npm run test:e2e)",
      "Bash(npm run fmt)",
      "Bash(npm run build)",
      "Bash(npm run knip)",
      "Bash(npm run doctor)",
      "Bash(npm run doctor -- --json)",
      "Bash(npm run surface:update)",
      "Bash(node scripts/guides.mjs)",
      "Bash(node scripts/new-command.mjs *)",
      "Bash(node node_modules/vitest/vitest.mjs run *)"
    ],
    "deny": ["Read(.env)", "Read(.env.*)"]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/session-start.mjs\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/post-edit.mjs\"",
            "timeout": 120
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/stop-check.mjs\"",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
