{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn"
  },
  "plugins": ["typescript", "oxc", "unicorn", "import"],
  "rules": {
    "no-console": "error",
    "typescript/consistent-return": "off",
    "eslint/no-underscore-dangle": [
      "error",
      {
        "allow": ["_tag"]
      }
    ],
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "node:fs",
            "message": "Use the FileSystem service so tests can swap the layer."
          },
          {
            "name": "node:fs/promises",
            "message": "Use the FileSystem service so tests can swap the layer."
          },
          {
            "name": "node:process",
            "message": "Only src/bin.ts touches the process; commands get services."
          },
          {
            "name": "effect/unstable/cli",
            "message": "Only src/contract/adapter.ts may import the parser \u2014 commands are defined as contracts."
          }
        ]
      }
    ],
    "no-restricted-globals": [
      "error",
      {
        "name": "process",
        "message": "Only src/bin.ts touches the process; commands get services."
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/bin.ts"],
      "rules": {
        "no-restricted-globals": "off",
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "node:fs",
                "message": "Use the FileSystem service so tests can swap the layer."
              },
              {
                "name": "effect/unstable/cli",
                "message": "bin.ts consumes kit-owned adapter types only."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/contract/adapter.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "node:fs",
                "message": "Use the FileSystem service so tests can swap the layer."
              },
              {
                "name": "node:process",
                "message": "Only src/bin.ts touches the process."
              }
            ]
          }
        ],
        "no-restricted-globals": "off"
      }
    },
    {
      "files": ["src/contract/adapter.ts", "src/contract/jsonschema.ts", "src/contract/surface.ts"],
      "rules": {
        "typescript/no-unsafe-type-assertion": "off"
      }
    },
    {
      "files": ["bin/**"],
      "rules": {
        "import/no-unassigned-import": "off"
      }
    },
    {
      "files": ["scripts/**", "test/**", ".claude/**"],
      "rules": {
        "no-console": "off",
        "no-restricted-imports": "off",
        "typescript/no-unsafe-type-assertion": "off",
        "no-restricted-globals": "off"
      }
    }
  ],
  "ignorePatterns": ["dist/**", "coverage/**", ".lasso/**"]
}
